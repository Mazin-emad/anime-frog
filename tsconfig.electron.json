{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist-electron",
    "rootDir": "./src/electron",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/electron/**/*"],
  "exclude": ["node_modules", "dist-electron", "src/electron/preload"]
}
